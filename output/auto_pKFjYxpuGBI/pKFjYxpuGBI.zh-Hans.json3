{"events": [{"tStartMs": 4799, "dDurationMs": 2560, "segs": [{"utf8": "宣布斐迪南阁下到来", "tOffsetMs": 0}]}, {"tStartMs": 7359, "dDurationMs": 3360, "segs": [{"utf8": "小马科斯,共和国总统", "tOffsetMs": 0}]}, {"tStartMs": 10719, "dDurationMs": 4346, "segs": [{"utf8": "菲律宾和尊敬的唐纳德·特朗普总统", "tOffsetMs": 0}]}, {"tStartMs": 15065, "dDurationMs": 3255, "segs": [{"utf8": "[音乐] 美利坚合众国,与第一", "tOffsetMs": 0}]}, {"tStartMs": 18320, "dDurationMs": 4680, "segs": [{"utf8": "路易丝·阿罗内塔·马科斯夫人.", "tOffsetMs": 0}]}, {"tStartMs": 25119, "dDurationMs": 3000, "segs": [{"utf8": "热. 热.", "tOffsetMs": 0}]}, {"tStartMs": 54365, "dDurationMs": 2020, "segs": [{"utf8": "[音乐]", "tOffsetMs": 0}]}, {"tStartMs": 68240, "dDurationMs": 4680, "segs": [{"utf8": "女士们先生们 请坐", "tOffsetMs": 0}]}, {"tStartMs": 87280, "dDurationMs": 4320, "segs": [{"utf8": "我们愿邀请他的杰出人物小费迪南德·马科斯", "tOffsetMs": 0}]}, {"tStartMs": 91600, "dDurationMs": 3040, "segs": [{"utf8": "发表他的意见。", "tOffsetMs": 0}]}, {"tStartMs": 94640, "dDurationMs": 3439, "segs": [{"utf8": "主席先生,贵宾们,女士们,先生们,", "tOffsetMs": 0}]}, {"tStartMs": 98079, "dDurationMs": 4261, "segs": [{"utf8": "很高兴欢迎唐纳德·特朗普总统", "tOffsetMs": 0}]}, {"tStartMs": 102340, "dDurationMs": 2860, "segs": [{"utf8": "回到菲律宾 在他的国家午餐。", "tOffsetMs": 0}]}, {"tStartMs": 105200, "dDurationMs": 3680, "segs": [{"utf8": "荣誉。 主席先生,我们非常高兴你与", "tOffsetMs": 0}]}, {"tStartMs": 108880, "dDurationMs": 2960, "segs": [{"utf8": "我们再次。 你的来访是特别的", "tOffsetMs": 0}]}, {"tStartMs": 111840, "dDurationMs": 3040, "segs": [{"utf8": "作为菲律宾和美国的重要时期", "tOffsetMs": 0}]}, {"tStartMs": 114880, "dDurationMs": 3839, "segs": [{"utf8": "纪念80年外交关系和75年", "tOffsetMs": 0}]}, {"tStartMs": 118719, "dDurationMs": 4161, "segs": [{"utf8": "我们的同盟 根据共同防御条约。", "tOffsetMs": 0}]}, {"tStartMs": 122880, "dDurationMs": 3040, "segs": [{"utf8": "这些周年提醒我们,", "tOffsetMs": 0}]}, {"tStartMs": 125920, "dDurationMs": 3360, "segs": [{"utf8": "我们两国不仅是政府之一", "tOffsetMs": 0}]}, {"tStartMs": 129280, "dDurationMs": 4640, "segs": [{"utf8": "机构。 它也是各国人民之间的关系", "tOffsetMs": 0}]}, {"tStartMs": 133920, "dDurationMs": 2080, "segs": [{"utf8": "建造历代。", "tOffsetMs": 0}]}, {"tStartMs": 136000, "dDurationMs": 4000, "segs": [{"utf8": "通过共同的牺牲和持久的友谊而得到加强,", "tOffsetMs": 0}]}, {"tStartMs": 140000, "dDurationMs": 4879, "segs": [{"utf8": "家庭纽带, 和深深的熟悉感和信任感,", "tOffsetMs": 0}]}, {"tStartMs": 144879, "dDurationMs": 3201, "segs": [{"utf8": "菲律宾人和美国人并肩作战", "tOffsetMs": 0}]}, {"tStartMs": 148080, "dDurationMs": 2960, "segs": [{"utf8": "我们共同经历的一些最重大的时刻", "tOffsetMs": 0}]}, {"tStartMs": 151040, "dDurationMs": 4160, "segs": [{"utf8": "历史 这种联系一直持续着,因为它继续", "tOffsetMs": 0}]}, {"tStartMs": 155200, "dDurationMs": 3759, "segs": [{"utf8": "与每一代人一起成长和适应.", "tOffsetMs": 0}]}, {"tStartMs": 158959, "dDurationMs": 3521, "segs": [{"utf8": "今天,我们庆祝这个历史,但我们也展望未来", "tOffsetMs": 0}]}, {"tStartMs": 162480, "dDurationMs": 1600, "segs": [{"utf8": "充满乐观", "tOffsetMs": 0}]}, {"tStartMs": 164080, "dDurationMs": 3439, "segs": [{"utf8": "我们今天的伙伴关系远远超出了防御和", "tOffsetMs": 0}]}, {"tStartMs": 167519, "dDurationMs": 3841, "segs": [{"utf8": "保安人员 我们正在加强贸易联系,", "tOffsetMs": 0}]}, {"tStartMs": 171360, "dDurationMs": 3360, "segs": [{"utf8": "投资、能源、技术、有复原力的供应", "tOffsetMs": 0}]}, {"tStartMs": 174720, "dDurationMs": 3519, "segs": [{"utf8": "连锁店、教育、直接影响", "tOffsetMs": 0}]}, {"tStartMs": 178239, "dDurationMs": 4161, "segs": [{"utf8": "我们两国人民的生活和愿望。", "tOffsetMs": 0}]}, {"tStartMs": 182400, "dDurationMs": 3440, "segs": [{"utf8": "主席先生,菲律宾深切地珍视联合国。", "tOffsetMs": 0}]}, {"tStartMs": 185840, "dDurationMs": 4800, "segs": [{"utf8": "国家作为一个值得信赖的朋友、坚定的伙伴和", "tOffsetMs": 0}]}, {"tStartMs": 190640, "dDurationMs": 1760, "segs": [{"utf8": "永远的盟友。", "tOffsetMs": 0}]}, {"tStartMs": 192400, "dDurationMs": 2960, "segs": [{"utf8": "我们也珍视个人的参与和承诺:", "tOffsetMs": 0}]}, {"tStartMs": 195360, "dDurationMs": 2799, "segs": [{"utf8": "你带来了我们的关系,确保", "tOffsetMs": 0}]}, {"tStartMs": 198159, "dDurationMs": 5201, "segs": [{"utf8": "我们的人民更加安全、强大和繁荣。", "tOffsetMs": 0}]}, {"tStartMs": 203360, "dDurationMs": 3440, "segs": [{"utf8": "我相信您的访问会给", "tOffsetMs": 0}]}, {"tStartMs": 206800, "dDurationMs": 2960, "segs": [{"utf8": "我们的伙伴关系和为我们两国开辟新的机会", "tOffsetMs": 0}]}, {"tStartMs": 209760, "dDurationMs": 3759, "segs": [{"utf8": "各国将更加密切地合作,", "tOffsetMs": 0}]}, {"tStartMs": 213519, "dDurationMs": 4000, "segs": [{"utf8": "人民,我们地区,我们地区的和平与繁荣", "tOffsetMs": 0}]}, {"tStartMs": 217519, "dDurationMs": 1841, "segs": [{"utf8": "我们都在寻找", "tOffsetMs": 0}]}, {"tStartMs": 219360, "dDurationMs": 4400, "segs": [{"utf8": "主席先生,代表菲律宾人民,", "tOffsetMs": 0}]}, {"tStartMs": 223760, "dDurationMs": 3520, "segs": [{"utf8": "我再次向你表示最热烈的欢迎。", "tOffsetMs": 0}]}, {"tStartMs": 227280, "dDurationMs": 3519, "segs": [{"utf8": "我们希望你们在菲律宾的家乡感到非常欣慰。", "tOffsetMs": 0}]}, {"tStartMs": 230799, "dDurationMs": 3281, "segs": [{"utf8": "现在请大家举杯", "tOffsetMs": 0}]}, {"tStartMs": 234080, "dDurationMs": 4000, "segs": [{"utf8": "特朗普总统身体健康 成功 永垂不朽", "tOffsetMs": 0}]}, {"tStartMs": 238080, "dDurationMs": 4879, "segs": [{"utf8": "菲律宾和美国人民之间的友谊", "tOffsetMs": 0}]}, {"tStartMs": 242959, "dDurationMs": 4321, "segs": [{"utf8": "菲律宾联盟", "tOffsetMs": 0}]}, {"tStartMs": 247280, "dDurationMs": 2319, "segs": [{"utf8": "未来的岁月", "tOffsetMs": 0}]}, {"tStartMs": 249599, "dDurationMs": 3000, "segs": [{"utf8": "菲律宾人。", "tOffsetMs": 0}]}, {"tStartMs": 253439, "dDurationMs": 3720, "segs": [{"utf8": "干杯,长官", "tOffsetMs": 0}]}, {"tStartMs": 266240, "dDurationMs": 3920, "segs": [{"utf8": "现在,我们请尊敬的唐纳德·特朗普来", "tOffsetMs": 0}]}, {"tStartMs": 270160, "dDurationMs": 1920, "segs": [{"utf8": "他的话。", "tOffsetMs": 0}]}, {"tStartMs": 272080, "dDurationMs": 3920, "segs": [{"utf8": "非常感谢 至此殊荣.", "tOffsetMs": 0}]}, {"tStartMs": 276000, "dDurationMs": 3440, "segs": [{"utf8": "马库斯总统 第一夫人 谢谢你", "tOffsetMs": 0}]}, {"tStartMs": 279440, "dDurationMs": 3840, "segs": [{"utf8": "欢迎回到这个特别美丽的地方", "tOffsetMs": 0}]}, {"tStartMs": 283280, "dDurationMs": 4240, "segs": [{"utf8": "国家。 没错 这是一个美丽的地方和很多", "tOffsetMs": 0}]}, {"tStartMs": 287520, "dDurationMs": 2080, "segs": [{"utf8": "人们在看今天发生的事情,他们会", "tOffsetMs": 0}]}, {"tStartMs": 289600, "dDurationMs": 2879, "segs": [{"utf8": "来这里。 这是一个大好机会的地方", "tOffsetMs": 0}]}, {"tStartMs": 292479, "dDurationMs": 1521, "segs": [{"utf8": "潜力。", "tOffsetMs": 0}]}, {"tStartMs": 294000, "dDurationMs": 3440, "segs": [{"utf8": "特别荣幸能在这里拜访你", "tOffsetMs": 0}]}, {"tStartMs": 297440, "dDurationMs": 3520, "segs": [{"utf8": "这座宫殿是一些最伟大的菲律宾人和", "tOffsetMs": 0}]}, {"tStartMs": 300960, "dDurationMs": 3440, "segs": [{"utf8": "我们之前的美国英雄 一起走过和工作", "tOffsetMs": 0}]}, {"tStartMs": 304400, "dDurationMs": 3440, "segs": [{"utf8": "捍卫我们两国的自由和荣耀。", "tOffsetMs": 0}]}, {"tStartMs": 307840, "dDurationMs": 3520, "segs": [{"utf8": "它背后有着巨大的历史.", "tOffsetMs": 0}]}, {"tStartMs": 311360, "dDurationMs": 4320, "segs": [{"utf8": "我得到了一个巡回 总统,这是相当的东西。", "tOffsetMs": 0}]}, {"tStartMs": 315680, "dDurationMs": 2799, "segs": [{"utf8": "美国和菲律宾之间的纽带是:", "tOffsetMs": 0}]}, {"tStartMs": 318479, "dDurationMs": 2081, "segs": [{"utf8": "珍爱和独特", "tOffsetMs": 0}]}, {"tStartMs": 320560, "dDurationMs": 4560, "segs": [{"utf8": "而我们的联盟, 它诞生于一个", "tOffsetMs": 0}]}, {"tStartMs": 325120, "dDurationMs": 3359, "segs": [{"utf8": "世世代代都证明了对自由的共同热爱,", "tOffsetMs": 0}]}, {"tStartMs": 328479, "dDurationMs": 4961, "segs": [{"utf8": "在一场精良的战役中被温和的 由双方维持", "tOffsetMs": 0}]}, {"tStartMs": 333440, "dDurationMs": 4000, "segs": [{"utf8": "承诺实现我们所有人民的繁荣与和平。", "tOffsetMs": 0}]}, {"tStartMs": 337440, "dDurationMs": 1520, "segs": [{"utf8": "我们合作得很好", "tOffsetMs": 0}]}, {"tStartMs": 338960, "dDurationMs": 2720, "segs": [{"utf8": "我们现在合作的比以往更好", "tOffsetMs": 0}]}, {"tStartMs": 341680, "dDurationMs": 3200, "segs": [{"utf8": "我们刚刚完成了一个非常大的交易,", "tOffsetMs": 0}]}, {"tStartMs": 344880, "dDurationMs": 3360, "segs": [{"utf8": "我们迄今为止做过最大的交易", "tOffsetMs": 0}]}, {"tStartMs": 348240, "dDurationMs": 2000, "segs": [{"utf8": "这对两国来说都是公平的交易.", "tOffsetMs": 0}]}, {"tStartMs": 350240, "dDurationMs": 2239, "segs": [{"utf8": "我们对此非常满意。", "tOffsetMs": 0}]}, {"tStartMs": 352479, "dDurationMs": 3440, "segs": [{"utf8": "我们不知道这会发生,但它", "tOffsetMs": 0}]}, {"tStartMs": 355919, "dDurationMs": 3280, "segs": [{"utf8": "发生得很快 和它是一个伟大的交易", "tOffsetMs": 0}]}, {"tStartMs": 359199, "dDurationMs": 3840, "segs": [{"utf8": "两个都一样 今天,在马库斯总统的领导下", "tOffsetMs": 0}]}, {"tStartMs": 363039, "dDurationMs": 3921, "segs": [{"utf8": "我自豪地说,我们正在结盟", "tOffsetMs": 0}]}, {"tStartMs": 366960, "dDurationMs": 2959, "segs": [{"utf8": "美国和菲律宾之间更紧密", "tOffsetMs": 0}]}, {"tStartMs": 369919, "dDurationMs": 2801, "segs": [{"utf8": "比以前更厉害 尤其是...", "tOffsetMs": 0}]}, {"tStartMs": 372720, "dDurationMs": 1919, "segs": [{"utf8": "完成这项交易。", "tOffsetMs": 0}]}, {"tStartMs": 374639, "dDurationMs": 3201, "segs": [{"utf8": "几代人之前 美国终结了西班牙的暴政", "tOffsetMs": 0}]}, {"tStartMs": 377840, "dDurationMs": 2960, "segs": [{"utf8": "并迅速占领了这些岛屿", "tOffsetMs": 0}]}, {"tStartMs": 380800, "dDurationMs": 3519, "segs": [{"utf8": "菲律宾现代化和独立的基础。", "tOffsetMs": 0}]}, {"tStartMs": 384319, "dDurationMs": 3121, "segs": [{"utf8": "从威廉·霍华德·塔夫脱到德怀特·D·艾森豪威尔, 其中一些人", "tOffsetMs": 0}]}, {"tStartMs": 387440, "dDurationMs": 3920, "segs": [{"utf8": "我们国家最优秀的头脑和最伟大的领袖", "tOffsetMs": 0}]}, {"tStartMs": 391360, "dDurationMs": 4240, "segs": [{"utf8": "我们的民族曾经生产过 刚刚注入了他们的心", "tOffsetMs": 0}]}, {"tStartMs": 395600, "dDurationMs": 3200, "segs": [{"utf8": "和他们的灵魂 他们一直知道这里是", "tOffsetMs": 0}]}, {"tStartMs": 398800, "dDurationMs": 3360, "segs": [{"utf8": "巨大的潜力。 我们有很多总统在看", "tOffsetMs": 0}]}, {"tStartMs": 402160, "dDurationMs": 2319, "segs": [{"utf8": "但我不认为曾经有过这样的时刻", "tOffsetMs": 0}]}, {"tStartMs": 404479, "dDurationMs": 4801, "segs": [{"utf8": "坦白说 当然,它就在这里,这座宫殿", "tOffsetMs": 0}]}, {"tStartMs": 409280, "dDurationMs": 3919, "segs": [{"utf8": "盖森总统授予道格拉斯·麦克阿瑟将军", "tOffsetMs": 0}]}, {"tStartMs": 413199, "dDurationMs": 4801, "segs": [{"utf8": "身着金色警棍 身着陆军元帅军衔", "tOffsetMs": 0}]}, {"tStartMs": 418000, "dDurationMs": 2479, "segs": [{"utf8": "菲律宾陆军. 我希望你能这样对我 如果你", "tOffsetMs": 0}]}, {"tStartMs": 420479, "dDurationMs": 2160, "segs": [{"utf8": "别介意 我喜欢", "tOffsetMs": 0}]}, {"tStartMs": 422639, "dDurationMs": 2881, "segs": [{"utf8": "我的意思是,为什么我不应该得到吗?", "tOffsetMs": 0}]}, {"tStartMs": 425520, "dDurationMs": 4720, "segs": [{"utf8": "但为了让骄傲的民族做好准备 保卫国土", "tOffsetMs": 0}]}, {"tStartMs": 430240, "dDurationMs": 2160, "segs": [{"utf8": "他们的父亲的土地。", "tOffsetMs": 0}]}, {"tStartMs": 432400, "dDurationMs": 3680, "segs": [{"utf8": "当战役从马尼拉的街道到", "tOffsetMs": 0}]}, {"tStartMs": 436080, "dDurationMs": 6160, "segs": [{"utf8": "走廊的悬崖 敬巴顿不朽的英雄们", "tOffsetMs": 0}]}, {"tStartMs": 442240, "dDurationMs": 4000, "segs": [{"utf8": "勇敢的美国和菲律宾 儿子们流血而死", "tOffsetMs": 0}]}, {"tStartMs": 446240, "dDurationMs": 4720, "segs": [{"utf8": "同样的沙子,岩石和泥土 捍卫这片土地", "tOffsetMs": 0}]}, {"tStartMs": 450960, "dDurationMs": 5519, "segs": [{"utf8": "我们的兄弟姐妹 还有我们的母亲 我们的父亲", "tOffsetMs": 0}]}, {"tStartMs": 456479, "dDurationMs": 4641, "segs": [{"utf8": "26万菲律宾英雄在星空下奋战", "tOffsetMs": 0}]}, {"tStartMs": 461120, "dDurationMs": 3120, "segs": [{"utf8": "二战和无数次美国服役的条纹", "tOffsetMs": 0}]}, {"tStartMs": 464240, "dDurationMs": 4239, "segs": [{"utf8": "成员们为了履行这一著名的承诺献出了生命。", "tOffsetMs": 0}]}, {"tStartMs": 468479, "dDurationMs": 2241, "segs": [{"utf8": "麦克阿瑟. 我会回来的", "tOffsetMs": 0}]}, {"tStartMs": 470720, "dDurationMs": 2560, "segs": [{"utf8": "他说,我会回来。", "tOffsetMs": 0}]}, {"tStartMs": 473280, "dDurationMs": 2960, "segs": [{"utf8": "因为牺牲了所有的人", "tOffsetMs": 0}]}, {"tStartMs": 476240, "dDurationMs": 2079, "segs": [{"utf8": "保持这个誓言。", "tOffsetMs": 0}]}, {"tStartMs": 478319, "dDurationMs": 3761, "segs": [{"utf8": "今天,菲律宾是自由的,马尼拉是", "tOffsetMs": 0}]}, {"tStartMs": 482080, "dDurationMs": 3760, "segs": [{"utf8": "美国最大的海外军事墓地", "tOffsetMs": 0}]}, {"tStartMs": 485840, "dDurationMs": 3359, "segs": [{"utf8": "这个世界 许多人为菲律宾而死,", "tOffsetMs": 0}]}, {"tStartMs": 489199, "dDurationMs": 2400, "segs": [{"utf8": "这就是为什么我很高兴 我们做了一个交易", "tOffsetMs": 0}]}, {"tStartMs": 491599, "dDurationMs": 4641, "segs": [{"utf8": "今时. 这种历史束缚着各国", "tOffsetMs": 0}]}, {"tStartMs": 496240, "dDurationMs": 5040, "segs": [{"utf8": "永远 而今天,我们真的呃... 我们期待我们面前的那些。", "tOffsetMs": 0}]}, {"tStartMs": 501280, "dDurationMs": 4160, "segs": [{"utf8": "马科斯总统和我继续努力捍卫和平", "tOffsetMs": 0}]}, {"tStartMs": 505440, "dDurationMs": 3120, "segs": [{"utf8": "我们的祖先赢了 他们如此勇敢地赢了。", "tOffsetMs": 0}]}, {"tStartMs": 508560, "dDurationMs": 6959, "segs": [{"utf8": "困难程度 实验室的恐怖程度", "tOffsetMs": 0}]}, {"tStartMs": 515519, "dDurationMs": 4320, "segs": [{"utf8": "这个国家的爱情水平是非凡的。", "tOffsetMs": 0}]}, {"tStartMs": 519839, "dDurationMs": 3200, "segs": [{"utf8": "和自由 我们的孩子会继承 世代", "tOffsetMs": 0}]}, {"tStartMs": 523039, "dDurationMs": 3441, "segs": [{"utf8": "来 他们会把菲律宾看成", "tOffsetMs": 0}]}, {"tStartMs": 526480, "dDurationMs": 2720, "segs": [{"utf8": "即使在美国历史上也是重要的", "tOffsetMs": 0}]}, {"tStartMs": 529200, "dDurationMs": 4160, "segs": [{"utf8": "现在随着今天的交易,它变得更加", "tOffsetMs": 0}]}, {"tStartMs": 533360, "dDurationMs": 2560, "segs": [{"utf8": "重要和更加团结。", "tOffsetMs": 0}]}, {"tStartMs": 535920, "dDurationMs": 3039, "segs": [{"utf8": "我们两国与日本最近发起了", "tOffsetMs": 0}]}, {"tStartMs": 538959, "dDurationMs": 4000, "segs": [{"utf8": "吕宋经济卫队,协助急需的", "tOffsetMs": 0}]}, {"tStartMs": 542959, "dDurationMs": 4000, "segs": [{"utf8": "世界中心十字路口的基础设施。", "tOffsetMs": 0}]}, {"tStartMs": 546959, "dDurationMs": 3521, "segs": [{"utf8": "今年我们庆祝75周年", "tOffsetMs": 0}]}, {"tStartMs": 550480, "dDurationMs": 4000, "segs": [{"utf8": "共同防御协议 我们的标志是", "tOffsetMs": 0}]}, {"tStartMs": 554480, "dDurationMs": 3280, "segs": [{"utf8": "有史以来最伟大的联合演习 聚集了我们所有的人", "tOffsetMs": 0}]}, {"tStartMs": 557760, "dDurationMs": 5360, "segs": [{"utf8": "部队横跨空中、陆地、海上、网络和空间。", "tOffsetMs": 0}]}, {"tStartMs": 563120, "dDurationMs": 4080, "segs": [{"utf8": "虽然我们分开了几千英里,当我", "tOffsetMs": 0}]}, {"tStartMs": 567200, "dDurationMs": 3920, "segs": [{"utf8": "说千里,千里远", "tOffsetMs": 0}]}, {"tStartMs": 571120, "dDurationMs": 3360, "segs": [{"utf8": "离开,但是它看起来真的接近我 因为", "tOffsetMs": 0}]}, {"tStartMs": 574480, "dDurationMs": 2720, "segs": [{"utf8": "关系。 它看起来并不遥远, 但我们的国家", "tOffsetMs": 0}]}, {"tStartMs": 577200, "dDurationMs": 4480, "segs": [{"utf8": "仍然因为共同利益和更多的", "tOffsetMs": 0}]}, {"tStartMs": 581680, "dDurationMs": 3760, "segs": [{"utf8": "文化和商业的持久联系以及", "tOffsetMs": 0}]}, {"tStartMs": 585440, "dDurationMs": 3040, "segs": [{"utf8": "很久以前我们第一次见面", "tOffsetMs": 0}]}, {"tStartMs": 588480, "dDurationMs": 3840, "segs": [{"utf8": "正如我们在美丽的圣诞装饰中看到的", "tOffsetMs": 0}]}, {"tStartMs": 592320, "dDurationMs": 2959, "segs": [{"utf8": "圣诞节是菲律宾的一大部分", "tOffsetMs": 0}]}, {"tStartMs": 595279, "dDurationMs": 3521, "segs": [{"utf8": "我来了,我说,\"哇,这是真的的东西。\"", "tOffsetMs": 0}]}, {"tStartMs": 598800, "dDurationMs": 2000, "segs": [{"utf8": "他们没说要带走圣诞节", "tOffsetMs": 0}]}, {"tStartMs": 600800, "dDurationMs": 2000, "segs": [{"utf8": "你知道,在我们的国家, 他们说, \"让我们不要使用", "tOffsetMs": 0}]}, {"tStartMs": 602800, "dDurationMs": 1599, "segs": [{"utf8": "圣诞节了。\"", "tOffsetMs": 0}]}, {"tStartMs": 604399, "dDurationMs": 2401, "segs": [{"utf8": "在2016年,我们结束了这一点。", "tOffsetMs": 0}]}, {"tStartMs": 606800, "dDurationMs": 1520, "segs": [{"utf8": "结束了。", "tOffsetMs": 0}]}, {"tStartMs": 608320, "dDurationMs": 2800, "segs": [{"utf8": "但是,他们对待圣诞节 用伟大的爱,", "tOffsetMs": 0}]}, {"tStartMs": 611120, "dDurationMs": 1520, "segs": [{"utf8": "在菲律宾,", "tOffsetMs": 0}]}, {"tStartMs": 612640, "dDurationMs": 3520, "segs": [{"utf8": "整个宫殿的装饰", "tOffsetMs": 0}]}, {"tStartMs": 616160, "dDurationMs": 7280, "segs": [{"utf8": "马尼拉表明我们人民也信仰上帝", "tOffsetMs": 0}]}, {"tStartMs": 623440, "dDurationMs": 3920, "segs": [{"utf8": "菲律宾人一直和我们在一起", "tOffsetMs": 0}]}, {"tStartMs": 627360, "dDurationMs": 3520, "segs": [{"utf8": "宗教,宗教是菲律宾的一大部分.", "tOffsetMs": 0}]}, {"tStartMs": 630880, "dDurationMs": 3680, "segs": [{"utf8": "那么,马科斯总统和第一夫人,两个不可思议的", "tOffsetMs": 0}]}, {"tStartMs": 634560, "dDurationMs": 3519, "segs": [{"utf8": "人们 再次感谢您的特别欢迎和", "tOffsetMs": 0}]}, {"tStartMs": 638079, "dDurationMs": 3760, "segs": [{"utf8": "继续友谊。 我请大家一起来", "tOffsetMs": 0}]}, {"tStartMs": 641839, "dDurationMs": 2161, "segs": [{"utf8": "在举杯时。", "tOffsetMs": 0}]}, {"tStartMs": 644000, "dDurationMs": 4720, "segs": [{"utf8": "愿我们的联盟 和那些造反的英雄一样坚强", "tOffsetMs": 0}]}, {"tStartMs": 648720, "dDurationMs": 3040, "segs": [{"utf8": "这个 我们一起领导美国和", "tOffsetMs": 0}]}, {"tStartMs": 651760, "dDurationMs": 3600, "segs": [{"utf8": "菲律宾走向更加安全的未来,", "tOffsetMs": 0}]}, {"tStartMs": 655360, "dDurationMs": 2800, "segs": [{"utf8": "繁荣与和平。 这些是很棒的人。", "tOffsetMs": 0}]}, {"tStartMs": 658160, "dDurationMs": 2560, "segs": [{"utf8": "这地方很棒 很荣幸能来", "tOffsetMs": 0}]}, {"tStartMs": 660720, "dDurationMs": 1840, "segs": [{"utf8": "非常感谢", "tOffsetMs": 0}]}, {"tStartMs": 663680, "dDurationMs": 3640, "segs": [{"utf8": "谢谢 干杯,长官", "tOffsetMs": 0}]}, {"tStartMs": 668399, "dDurationMs": 4281, "segs": [{"utf8": "谢谢 非常感谢", "tOffsetMs": 0}]}, {"tStartMs": 679839, "dDurationMs": 3841, "segs": [{"utf8": "谢谢,各位贵宾,各位贵宾", "tOffsetMs": 0}]}, {"tStartMs": 683680, "dDurationMs": 5000, "segs": [{"utf8": "各位,我们现在开始午餐", "tOffsetMs": 0}]}], "wireMagic": "mb1", "lang": "zh-Hans"}