{"events": [{"tStartMs": 8320, "dDurationMs": 2319, "segs": [{"utf8": "特朗普总统阁下", "tOffsetMs": 0}]}, {"tStartMs": 10639, "dDurationMs": 3040, "segs": [{"utf8": "女士们先生们 早上好", "tOffsetMs": 0}]}, {"tStartMs": 13679, "dDurationMs": 3360, "segs": [{"utf8": "主席先生,你昨天才到马尼拉", "tOffsetMs": 0}]}, {"tStartMs": 17039, "dDurationMs": 4801, "segs": [{"utf8": "您的行程已经打包到空档了, 就是", "tOffsetMs": 0}]}, {"tStartMs": 21840, "dDurationMs": 4240, "segs": [{"utf8": "并不是一个惊喜,因为我们知道你有多努力。", "tOffsetMs": 0}]}, {"tStartMs": 26080, "dDurationMs": 2640, "segs": [{"utf8": "昨晚,第一夫人和我很高兴", "tOffsetMs": 0}]}, {"tStartMs": 28720, "dDurationMs": 4560, "segs": [{"utf8": "接待你和其他领导人及其配偶", "tOffsetMs": 0}]}, {"tStartMs": 33280, "dDurationMs": 3200, "segs": [{"utf8": "阿桑美国特别峰会.", "tOffsetMs": 0}]}, {"tStartMs": 36480, "dDurationMs": 2880, "segs": [{"utf8": "我惊讶地听到 在短短几个小时内,你有", "tOffsetMs": 0}]}, {"tStartMs": 39360, "dDurationMs": 3039, "segs": [{"utf8": "已经与其他机构举行了几次实质性会议。", "tOffsetMs": 0}]}, {"tStartMs": 42399, "dDurationMs": 3840, "segs": [{"utf8": "头儿们 几小时后我们就要出发了", "tOffsetMs": 0}]}, {"tStartMs": 46239, "dDurationMs": 3681, "segs": [{"utf8": "马尼拉。 这次是去亚太经合组织经济领导人那里", "tOffsetMs": 0}]}, {"tStartMs": 49920, "dDurationMs": 2240, "segs": [{"utf8": "在深圳开会.", "tOffsetMs": 0}]}, {"tStartMs": 52160, "dDurationMs": 2640, "segs": [{"utf8": "不幸的是,这意味着你在这里的时间很少", "tOffsetMs": 0}]}, {"tStartMs": 54800, "dDurationMs": 1599, "segs": [{"utf8": "在马尼拉。", "tOffsetMs": 0}]}, {"tStartMs": 56399, "dDurationMs": 5121, "segs": [{"utf8": "幸运的是,你的短暂停留在这里 包括一个非常", "tOffsetMs": 0}]}, {"tStartMs": 61520, "dDurationMs": 3999, "segs": [{"utf8": "宫殿之旅的高度收缩版本", "tOffsetMs": 0}]}, {"tStartMs": 65519, "dDurationMs": 6081, "segs": [{"utf8": "是一些我能够告诉你的", "tOffsetMs": 0}]}, {"tStartMs": 71600, "dDurationMs": 3199, "segs": [{"utf8": "历史已经发生了。 这是非常的", "tOffsetMs": 0}]}, {"tStartMs": 74799, "dDurationMs": 3680, "segs": [{"utf8": "历史是在这些建筑里创造的", "tOffsetMs": 0}]}, {"tStartMs": 78479, "dDurationMs": 4801, "segs": [{"utf8": "特别是今年我们两国", "tOffsetMs": 0}]}, {"tStartMs": 83280, "dDurationMs": 3920, "segs": [{"utf8": "纪念80年的外交[鼻]关系和", "tOffsetMs": 0}]}, {"tStartMs": 87200, "dDurationMs": 4720, "segs": [{"utf8": "美国75年的联盟", "tOffsetMs": 0}]}, {"tStartMs": 91920, "dDurationMs": 2640, "segs": [{"utf8": "共同防御条约", "tOffsetMs": 0}]}, {"tStartMs": 94560, "dDurationMs": 4000, "segs": [{"utf8": "但是,我们两国人民之间的关系 远比", "tOffsetMs": 0}]}, {"tStartMs": 98560, "dDurationMs": 3599, "segs": [{"utf8": "不同形式的世纪", "tOffsetMs": 0}]}, {"tStartMs": 102159, "dDurationMs": 4240, "segs": [{"utf8": "美国是我们唯一的条约盟友和我们", "tOffsetMs": 0}]}, {"tStartMs": 106399, "dDurationMs": 3601, "segs": [{"utf8": "关系在不断增长和演进,在众多的", "tOffsetMs": 0}]}, {"tStartMs": 110000, "dDurationMs": 4479, "segs": [{"utf8": "岁月。 现在我们也在探索新的合作领域", "tOffsetMs": 0}]}, {"tStartMs": 114479, "dDurationMs": 3121, "segs": [{"utf8": "特别是美国领导人和", "tOffsetMs": 0}]}, {"tStartMs": 117600, "dDurationMs": 2960, "segs": [{"utf8": "创新继续领先。", "tOffsetMs": 0}]}, {"tStartMs": 120560, "dDurationMs": 2879, "segs": [{"utf8": "我们还看到了更多的工作机会", "tOffsetMs": 0}]}, {"tStartMs": 123439, "dDurationMs": 3921, "segs": [{"utf8": "通过美国在超级情报方面的领导力", "tOffsetMs": 0}]}, {"tStartMs": 127360, "dDurationMs": 3760, "segs": [{"utf8": "当我们展望未来时 我相信我们会", "tOffsetMs": 0}]}, {"tStartMs": 131120, "dDurationMs": 5520, "segs": [{"utf8": "找到新的重要途径来深化我们的伙伴关系。", "tOffsetMs": 0}]}, {"tStartMs": 136640, "dDurationMs": 3200, "segs": [{"utf8": "不过,既然你被绑了一段时间,我想尝尝", "tOffsetMs": 0}]}, {"tStartMs": 139840, "dDurationMs": 3200, "segs": [{"utf8": "马尼拉也许很好", "tOffsetMs": 0}]}, {"tStartMs": 143040, "dDurationMs": 5120, "segs": [{"utf8": "所以,昨晚,我要求我的员工... ...嗯,有一些Jollibee", "tOffsetMs": 0}]}, {"tStartMs": 148160, "dDurationMs": 2799, "segs": [{"utf8": "送给你和你的深夜小吃", "tOffsetMs": 0}]}, {"tStartMs": 150959, "dDurationMs": 4481, "segs": [{"utf8": "代表团。 我认为他们给了你 um Jollibee是一个", "tOffsetMs": 0}]}, {"tStartMs": 155440, "dDurationMs": 5680, "segs": [{"utf8": "是个非常受欢迎的链条 也是他们的主要", "tOffsetMs": 0}]}, {"tStartMs": 161120, "dDurationMs": 4160, "segs": [{"utf8": "产品是炸鸡 我们非常自豪地说", "tOffsetMs": 0}]}, {"tStartMs": 165280, "dDurationMs": 4560, "segs": [{"utf8": "我们在美国超过KFC", "tOffsetMs": 0}]}, {"tStartMs": 169840, "dDurationMs": 4240, "segs": [{"utf8": "受欢迎 所以我们觉得这会让你尝尝", "tOffsetMs": 0}]}, {"tStartMs": 174080, "dDurationMs": 3600, "segs": [{"utf8": "马尼拉和我想我希望你的一些工作人员也", "tOffsetMs": 0}]}, {"tStartMs": 177680, "dDurationMs": 1919, "segs": [{"utf8": "能够分享。", "tOffsetMs": 0}]}, {"tStartMs": 179599, "dDurationMs": 2720, "segs": [{"utf8": "你一直在努力工作,总统先生。", "tOffsetMs": 0}]}, {"tStartMs": 182319, "dDurationMs": 4000, "segs": [{"utf8": "所以就当是给大家额外的能量", "tOffsetMs": 0}]}, {"tStartMs": 186319, "dDurationMs": 2321, "segs": [{"utf8": "完成你必须完成的工作", "tOffsetMs": 0}]}, {"tStartMs": 188640, "dDurationMs": 3440, "segs": [{"utf8": "继续做,呃,这是在你面前。", "tOffsetMs": 0}]}, {"tStartMs": 192080, "dDurationMs": 3600, "segs": [{"utf8": "所以我不会占用你太多时间 我知道", "tOffsetMs": 0}]}, {"tStartMs": 195680, "dDurationMs": 3919, "segs": [{"utf8": "我们的时间很短,我们还有很多工作要做", "tOffsetMs": 0}]}, {"tStartMs": 199599, "dDurationMs": 2000, "segs": [{"utf8": "在去吃午饭前通过", "tOffsetMs": 0}]}, {"tStartMs": 201599, "dDurationMs": 1521, "segs": [{"utf8": "因此,主席先生,欢迎。", "tOffsetMs": 0}]}, {"tStartMs": 203120, "dDurationMs": 4320, "segs": [{"utf8": "非常感谢 我想感谢马科斯总统,", "tOffsetMs": 0}]}, {"tStartMs": 207440, "dDurationMs": 2560, "segs": [{"utf8": "伟大的人和我的一个好朋友。", "tOffsetMs": 0}]}, {"tStartMs": 210000, "dDurationMs": 2560, "segs": [{"utf8": "相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相相", "tOffsetMs": 0}]}, {"tStartMs": 212560, "dDurationMs": 5360, "segs": [{"utf8": "我非常感谢你欢迎我们回来", "tOffsetMs": 0}]}, {"tStartMs": 217920, "dDurationMs": 3360, "segs": [{"utf8": "我们再次确认美国最古老的", "tOffsetMs": 0}]}, {"tStartMs": 221280, "dDurationMs": 4000, "segs": [{"utf8": "以及太平洋最重要的联盟。", "tOffsetMs": 0}]}, {"tStartMs": 225280, "dDurationMs": 3760, "segs": [{"utf8": "一代又一代的美国人和菲律宾爱国者", "tOffsetMs": 0}]}, {"tStartMs": 229040, "dDurationMs": 2640, "segs": [{"utf8": "并肩并肩,形成一种纽带。", "tOffsetMs": 0}]}, {"tStartMs": 231680, "dDurationMs": 3600, "segs": [{"utf8": "这是血缘关系 捍卫主权", "tOffsetMs": 0}]}, {"tStartMs": 235280, "dDurationMs": 2159, "segs": [{"utf8": "和我们两国的自由。", "tOffsetMs": 0}]}, {"tStartMs": 237439, "dDurationMs": 2948, "segs": [{"utf8": "我们在一起很久了", "tOffsetMs": 0}]}, {"tStartMs": 240387, "dDurationMs": 2653, "segs": [{"utf8": "[鼻 我国人民有着共同的历史和共同的价值观,", "tOffsetMs": 0}]}, {"tStartMs": 243040, "dDurationMs": 4399, "segs": [{"utf8": "共同利益,建筑品味", "tOffsetMs": 0}]}, {"tStartMs": 247439, "dDurationMs": 1921, "segs": [{"utf8": "我喜欢你在这里所做的", "tOffsetMs": 0}]}, {"tStartMs": 249360, "dDurationMs": 2959, "segs": [{"utf8": "做了一个了不起的工作。 但这次访问,我们正在建设", "tOffsetMs": 0}]}, {"tStartMs": 252319, "dDurationMs": 3760, "segs": [{"utf8": "我们的合作关系更紧密", "tOffsetMs": 0}]}, {"tStartMs": 256079, "dDurationMs": 2481, "segs": [{"utf8": "虽然我无法想象它能更接近 因为", "tOffsetMs": 0}]}, {"tStartMs": 258560, "dDurationMs": 3199, "segs": [{"utf8": "我们很久以来的关系", "tOffsetMs": 0}]}, {"tStartMs": 261759, "dDurationMs": 3521, "segs": [{"utf8": "我们两国与日本最近发起了", "tOffsetMs": 0}]}, {"tStartMs": 265280, "dDurationMs": 3600, "segs": [{"utf8": "吕宋经济走廊,最终目标是绘制", "tOffsetMs": 0}]}, {"tStartMs": 268880, "dDurationMs": 3680, "segs": [{"utf8": "志同道合的国家投资1000亿美元", "tOffsetMs": 0}]}, {"tStartMs": 272560, "dDurationMs": 1760, "segs": [{"utf8": "他们来来来去去。", "tOffsetMs": 0}]}, {"tStartMs": 274320, "dDurationMs": 4319, "segs": [{"utf8": "如你所知,关键产业和经济安全", "tOffsetMs": 0}]}, {"tStartMs": 278639, "dDurationMs": 3441, "segs": [{"utf8": "和菲律宾... ...呃... ...将在那里很长一段时间", "tOffsetMs": 0}]}, {"tStartMs": 282080, "dDurationMs": 2160, "segs": [{"utf8": "我们一直和你在一起", "tOffsetMs": 0}]}, {"tStartMs": 284240, "dDurationMs": 2880, "segs": [{"utf8": "还有其他许多领域,我们两国可以", "tOffsetMs": 0}]}, {"tStartMs": 287120, "dDurationMs": 4320, "segs": [{"utf8": "加强我们的合作,包括能源安全。", "tOffsetMs": 0}]}, {"tStartMs": 291440, "dDurationMs": 3039, "segs": [{"utf8": "我们的能量比世界上任何国家都多", "tOffsetMs": 0}]}, {"tStartMs": 294479, "dDurationMs": 2961, "segs": [{"utf8": "双倍,甚至更多。", "tOffsetMs": 0}]}, {"tStartMs": 297440, "dDurationMs": 3680, "segs": [{"utf8": "如果你加上俄罗斯和沙特阿拉伯, 我们有很多", "tOffsetMs": 0}]}, {"tStartMs": 301120, "dDurationMs": 3458, "segs": [{"utf8": "比这两个加起来还要大", "tOffsetMs": 0}]}, {"tStartMs": 304578, "dDurationMs": 2942, "segs": [{"utf8": "[鼻 然后你加委内瑞拉, 这是我们的新", "tOffsetMs": 0}]}, {"tStartMs": 307520, "dDurationMs": 1600, "segs": [{"utf8": "获取。", "tOffsetMs": 0}]}, {"tStartMs": 309120, "dDurationMs": 3120, "segs": [{"utf8": "无论人们喜欢这么说还是", "tOffsetMs": 0}]}, {"tStartMs": 312240, "dDurationMs": 3519, "segs": [{"utf8": "没有 曼联发生的事真是令人惊讶", "tOffsetMs": 0}]}, {"tStartMs": 315759, "dDurationMs": 3361, "segs": [{"utf8": "国家。 但美国现在是世界领先", "tOffsetMs": 0}]}, {"tStartMs": 319120, "dDurationMs": 2639, "segs": [{"utf8": "石油和天然气的生产商很多。", "tOffsetMs": 0}]}, {"tStartMs": 321759, "dDurationMs": 3041, "segs": [{"utf8": "我们刚刚宣布阿拉斯加的一条重要新管道", "tOffsetMs": 0}]}, {"tStartMs": 324800, "dDurationMs": 3360, "segs": [{"utf8": "向我国出口负担得起的、丰富的能源供应", "tOffsetMs": 0}]}, {"tStartMs": 328160, "dDurationMs": 2240, "segs": [{"utf8": "太平洋的盟友和朋友", "tOffsetMs": 0}]}, {"tStartMs": 330400, "dDurationMs": 4320, "segs": [{"utf8": "而菲律宾将是一个非常自然的合作伙伴", "tOffsetMs": 0}]}, {"tStartMs": 334720, "dDurationMs": 1520, "segs": [{"utf8": "努力起来。 我们正在努力。", "tOffsetMs": 0}]}, {"tStartMs": 336240, "dDurationMs": 4000, "segs": [{"utf8": "你想用那个 我们有巨大的能量和巨大的能量", "tOffsetMs": 0}]}, {"tStartMs": 340240, "dDurationMs": 3440, "segs": [{"utf8": "水平。 我们拥有它数百年的未来。", "tOffsetMs": 0}]}, {"tStartMs": 343680, "dDurationMs": 3600, "segs": [{"utf8": "但美国的民用核工业也是最好的", "tOffsetMs": 0}]}, {"tStartMs": 347280, "dDurationMs": 1520, "segs": [{"utf8": "和世界上最先进的。", "tOffsetMs": 0}]}, {"tStartMs": 348800, "dDurationMs": 1920, "segs": [{"utf8": "我们正在处理你。", "tOffsetMs": 0}]}, {"tStartMs": 350720, "dDurationMs": 3039, "segs": [{"utf8": "而菲律宾则接受美国科技", "tOffsetMs": 0}]}, {"tStartMs": 353759, "dDurationMs": 3280, "segs": [{"utf8": "其第一个现代核项目将强调", "tOffsetMs": 0}]}, {"tStartMs": 357039, "dDurationMs": 4241, "segs": [{"utf8": "重要关系的力量,我们要", "tOffsetMs": 0}]}, {"tStartMs": 361280, "dDurationMs": 2800, "segs": [{"utf8": "也许做一件与核有关的事情", "tOffsetMs": 0}]}, {"tStartMs": 364080, "dDurationMs": 4160, "segs": [{"utf8": "我们非常喜欢核子 现在它是安全的,强大的,", "tOffsetMs": 0}]}, {"tStartMs": 368240, "dDurationMs": 2880, "segs": [{"utf8": "安全而廉价", "tOffsetMs": 0}]}, {"tStartMs": 371120, "dDurationMs": 3040, "segs": [{"utf8": "与马库斯总统合作,我们也在扩大", "tOffsetMs": 0}]}, {"tStartMs": 374160, "dDurationMs": 3280, "segs": [{"utf8": "国防合作,始终是", "tOffsetMs": 0}]}, {"tStartMs": 377440, "dDurationMs": 2960, "segs": [{"utf8": "世界这一地区的安全。", "tOffsetMs": 0}]}, {"tStartMs": 380400, "dDurationMs": 2880, "segs": [{"utf8": "自从我上任以来,我们一直支持历史性的增长", "tOffsetMs": 0}]}, {"tStartMs": 383280, "dDurationMs": 4160, "segs": [{"utf8": "外国向菲律宾提供军事资助,批准", "tOffsetMs": 0}]}, {"tStartMs": 387440, "dDurationMs": 2240, "segs": [{"utf8": "销售额超过50亿美元。", "tOffsetMs": 0}]}, {"tStartMs": 389680, "dDurationMs": 2160, "segs": [{"utf8": "我们制造出最好的武器", "tOffsetMs": 0}]}, {"tStartMs": 391840, "dDurationMs": 4320, "segs": [{"utf8": "我们制造出世界上最好的军事装备", "tOffsetMs": 0}]}, {"tStartMs": 396160, "dDurationMs": 6479, "segs": [{"utf8": "或者你是否叫他们 呃... ...我会说爱国者有。", "tOffsetMs": 0}]}, {"tStartMs": 402639, "dDurationMs": 3120, "segs": [{"utf8": "你可以看看防御武器,你可以", "tOffsetMs": 0}]}, {"tStartMs": 405759, "dDurationMs": 3521, "segs": [{"utf8": "看进攻性武器 没人能制造出这样武器", "tOffsetMs": 0}]}, {"tStartMs": 409280, "dDurationMs": 2320, "segs": [{"utf8": "我们做,我们正在让他们更快。", "tOffsetMs": 0}]}, {"tStartMs": 411600, "dDurationMs": 2240, "segs": [{"utf8": "我们正在建造21个植物", "tOffsetMs": 0}]}, {"tStartMs": 413840, "dDurationMs": 3600, "segs": [{"utf8": "他们正在扩大工业基地和军队", "tOffsetMs": 0}]}, {"tStartMs": 417440, "dDurationMs": 3599, "segs": [{"utf8": "工业基础正在大幅扩展,所以", "tOffsetMs": 0}]}, {"tStartMs": 421039, "dDurationMs": 2641, "segs": [{"utf8": "点菜的时候不用等那么久", "tOffsetMs": 0}]}, {"tStartMs": 423680, "dDurationMs": 1919, "segs": [{"utf8": "但是,我们有呃 Tomahawks。", "tOffsetMs": 0}]}, {"tStartMs": 425599, "dDurationMs": 1681, "segs": [{"utf8": "我们拥有一切", "tOffsetMs": 0}]}, {"tStartMs": 427280, "dDurationMs": 1600, "segs": [{"utf8": "每个人都想要它。", "tOffsetMs": 0}]}, {"tStartMs": 428880, "dDurationMs": 1680, "segs": [{"utf8": "我们只和朋友打交道", "tOffsetMs": 0}]}, {"tStartMs": 430560, "dDurationMs": 1520, "segs": [{"utf8": "我们把它给朋友。", "tOffsetMs": 0}]}, {"tStartMs": 432080, "dDurationMs": 2559, "segs": [{"utf8": "卖好军事装备给美国可不是个好主意", "tOffsetMs": 0}]}, {"tStartMs": 434639, "dDurationMs": 2081, "segs": [{"utf8": "敌人 我们确实有敌人", "tOffsetMs": 0}]}, {"tStartMs": 436720, "dDurationMs": 3440, "segs": [{"utf8": "但我们有最好的军事和最好的", "tOffsetMs": 0}]}, {"tStartMs": 440160, "dDurationMs": 3200, "segs": [{"utf8": "最好的军事和军械装备", "tOffsetMs": 0}]}, {"tStartMs": 443360, "dDurationMs": 4720, "segs": [{"utf8": "地球,你知道,我们有战争 你可以把它叫做什么", "tOffsetMs": 0}]}, {"tStartMs": 448080, "dDurationMs": 2959, "segs": [{"utf8": "可能就是委内瑞拉迅速发展起来。", "tOffsetMs": 0}]}, {"tStartMs": 451039, "dDurationMs": 2961, "segs": [{"utf8": "没有人被杀。 考虑一下 有一天没有人被杀", "tOffsetMs": 0}]}, {"tStartMs": 454000, "dDurationMs": 4560, "segs": [{"utf8": "确切地说 它持续了48分钟 结束了", "tOffsetMs": 0}]}, {"tStartMs": 458560, "dDurationMs": 3759, "segs": [{"utf8": "在伊朗,我们做得非常好,可以轻而易举地说。", "tOffsetMs": 0}]}, {"tStartMs": 462319, "dDurationMs": 1841, "segs": [{"utf8": "他们没有海军。 他们没有空军", "tOffsetMs": 0}]}, {"tStartMs": 464160, "dDurationMs": 4080, "segs": [{"utf8": "他们什么都没有。 但美国与菲律宾人站在一起", "tOffsetMs": 0}]}, {"tStartMs": 468240, "dDurationMs": 2160, "segs": [{"utf8": "和我们世世代代一样", "tOffsetMs": 0}]}, {"tStartMs": 470400, "dDurationMs": 3440, "segs": [{"utf8": "我们一直是你的盟友,但不是现在那么亲近。", "tOffsetMs": 0}]}, {"tStartMs": 473840, "dDurationMs": 1520, "segs": [{"utf8": "但我们一直是你的盟友", "tOffsetMs": 0}]}, {"tStartMs": 475360, "dDurationMs": 3519, "segs": [{"utf8": "然后,你有一些时候 联盟不是", "tOffsetMs": 0}]}, {"tStartMs": 478879, "dDurationMs": 2561, "segs": [{"utf8": "在前几届政府期间表现很好", "tOffsetMs": 0}]}, {"tStartMs": 481440, "dDurationMs": 1920, "segs": [{"utf8": "这不是一个非常好的联盟。", "tOffsetMs": 0}]}, {"tStartMs": 483360, "dDurationMs": 2640, "segs": [{"utf8": "但我们的联盟从未如此好过.", "tOffsetMs": 0}]}, {"tStartMs": 486000, "dDurationMs": 3360, "segs": [{"utf8": "我要再次感谢马库斯总统主持", "tOffsetMs": 0}]}, {"tStartMs": 489360, "dDurationMs": 4399, "segs": [{"utf8": "一次杰出的ACSEAN峰会 以及最后的晚餐", "tOffsetMs": 0}]}, {"tStartMs": 493759, "dDurationMs": 2720, "segs": [{"utf8": "和东南亚所有领导人一起过夜", "tOffsetMs": 0}]}, {"tStartMs": 496479, "dDurationMs": 3761, "segs": [{"utf8": "我们和他们都见过面 他们非常尊重", "tOffsetMs": 0}]}, {"tStartMs": 500240, "dDurationMs": 2239, "segs": [{"utf8": "你吗? 我必须告诉你,我也一样。", "tOffsetMs": 0}]}, {"tStartMs": 502479, "dDurationMs": 1921, "segs": [{"utf8": "谢谢你邀请我们", "tOffsetMs": 0}]}, {"tStartMs": 504400, "dDurationMs": 3040, "segs": [{"utf8": "谢谢 谢谢 再次感谢你,总统先生。", "tOffsetMs": 0}]}, {"tStartMs": 507440, "dDurationMs": 4080, "segs": [{"utf8": "所以,呃,如果你多关心 你有多关心", "tOffsetMs": 0}]}, {"tStartMs": 511520, "dDurationMs": 3199, "segs": [{"utf8": "关于西菲尔的紧张 如果菲林斯", "tOffsetMs": 0}]}, {"tStartMs": 514719, "dDurationMs": 1921, "segs": [{"utf8": "援引M条约。", "tOffsetMs": 0}]}, {"tStartMs": 516640, "dDurationMs": 2720, "segs": [{"utf8": "你准备好了吗? 我一点都不担心", "tOffsetMs": 0}]}, {"tStartMs": 519360, "dDurationMs": 1760, "segs": [{"utf8": "我一点都不担心", "tOffsetMs": 0}]}, {"tStartMs": 521120, "dDurationMs": 2960, "segs": [{"utf8": "那会解决的", "tOffsetMs": 0}]}, {"tStartMs": 524080, "dDurationMs": 4160, "segs": [{"utf8": "还有别的问题吗? 还有别的问题吗?", "tOffsetMs": 0}]}, {"tStartMs": 528240, "dDurationMs": 2800, "segs": [{"utf8": "你是唯一能说话的人吗?", "tOffsetMs": 0}]}, {"tStartMs": 531040, "dDurationMs": 3479, "segs": [{"utf8": "还有别的问题吗?", "tOffsetMs": 0}]}, {"tStartMs": 536240, "dDurationMs": 3680, "segs": [{"utf8": "再说一遍,报告。", "tOffsetMs": 0}]}, {"tStartMs": 539920, "dDurationMs": 1760, "segs": [{"utf8": "你想回答吗?", "tOffsetMs": 0}]}, {"tStartMs": 541680, "dDurationMs": 2960, "segs": [{"utf8": "没有迹象", "tOffsetMs": 0}]}, {"tStartMs": 544640, "dDurationMs": 1520, "segs": [{"utf8": "没有签名。", "tOffsetMs": 0}]}, {"tStartMs": 546160, "dDurationMs": 4799, "segs": [{"utf8": "不,不,不,不,不是在这个旅行。", "tOffsetMs": 0}]}, {"tStartMs": 550959, "dDurationMs": 4961, "segs": [{"utf8": "我们没有这样做,我们没有在本次旅行中涵盖这一点。", "tOffsetMs": 0}]}, {"tStartMs": 555920, "dDurationMs": 1520, "segs": [{"utf8": "先生非常感谢。", "tOffsetMs": 0}]}, {"tStartMs": 557440, "dDurationMs": 1920, "segs": [{"utf8": "非常感谢 非常感谢各位", "tOffsetMs": 0}]}, {"tStartMs": 559360, "dDurationMs": 3720, "segs": [{"utf8": "谢谢女士们,温柔地。", "tOffsetMs": 0}]}, {"tStartMs": 572560, "dDurationMs": 3120, "segs": [{"utf8": "还有别的问题吗?", "tOffsetMs": 0}]}], "wireMagic": "mb1", "lang": "zh-Hans"}