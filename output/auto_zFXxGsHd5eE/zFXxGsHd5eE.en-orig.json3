    } ]
  }, {
    "tStartMs": 2118000,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "the national president of the Fraternal\nOrder of Police and a big supporter of",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2124400,
    "dDurationMs": 7439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "me and people that really uh believe in\nyou, the people in this room, Patrick",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2129680,
    "dDurationMs": 5399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Yo. Patrick, thank you. Thank you very\nmuch, Patrick.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2135119,
    "dDurationMs": 10521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "President of the California Fraternal\nOrder of Police, Roger Hilton. Roger,",
