    "dDurationMs": 4680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "thank you. Thank you.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2145839,
    "dDurationMs": 10441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "President of the Federal Law Enforcement\nOfficers Association, Matthew Silverman.",
