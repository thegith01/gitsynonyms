    } ]
  }, {
    "tStartMs": 2062399,
    "dDurationMs": 3161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "long time.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2065760,
    "dDurationMs": 10079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Great job.\nThanks as well to FBI Director Cash",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2071359,
    "dDurationMs": 10401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Patel, DEA Administrator Terry Cole,\nDire Stand up fellows, will you please?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2078320,
    "dDurationMs": 7400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "You know, you deserve to stand up.\nGood. Hi, Terry.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2087760,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Director of the Bureau of Prisons, Billy\nMarshall. Billy, thank you, Billy.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2094720,
    "dDurationMs": 8600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Thank you.\nUS Attorney for the District of",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2099280,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Columbia, Janine Piro.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2104640,
    "dDurationMs": 9120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Thank you, Janine.\nCongressman Brandon Gil, a future star,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2111599,
    "dDurationMs": 5161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "I predict,\nright?",
