{"events": [{"tStartMs": 0, "dDurationMs": 3280, "segs": [{"utf8": "我叫贾里德·艾萨克曼 我是NASA的管理员", "tOffsetMs": 0}]}, {"tStartMs": 3280, "dDurationMs": 2079, "segs": [{"utf8": "我有幸领导世界最", "tOffsetMs": 0}]}, {"tStartMs": 5359, "dDurationMs": 3041, "segs": [{"utf8": "科学黄金时代完成的空间机构", "tOffsetMs": 0}]}, {"tStartMs": 8400, "dDurationMs": 2080, "segs": [{"utf8": "和发现。 我们要回月球了", "tOffsetMs": 0}]}, {"tStartMs": 10480, "dDurationMs": 1600, "segs": [{"utf8": "我们在这里与阿耳忒弥斯3。", "tOffsetMs": 0}]}, {"tStartMs": 12080, "dDurationMs": 1679, "segs": [{"utf8": "2027年发射.", "tOffsetMs": 0}]}, {"tStartMs": 13759, "dDurationMs": 2321, "segs": [{"utf8": "我们很高兴代表美国和美国", "tOffsetMs": 0}]}, {"tStartMs": 16080, "dDurationMs": 3600, "segs": [{"utf8": "人类 欧洲希望成为最强大最可靠的国家", "tOffsetMs": 0}]}, {"tStartMs": 19680, "dDurationMs": 2000, "segs": [{"utf8": "探索月球的合作伙伴", "tOffsetMs": 0}]}, {"tStartMs": 21680, "dDurationMs": 2640, "segs": [{"utf8": "我们发射的火箭与SLS不同", "tOffsetMs": 0}]}, {"tStartMs": 24320, "dDurationMs": 2719, "segs": [{"utf8": "前往\"星舰\"和\"蓝色起源\"火箭", "tOffsetMs": 0}]}, {"tStartMs": 27039, "dDurationMs": 2801, "segs": [{"utf8": "一定会很棒的 为《公约》缔约方会议", "tOffsetMs": 0}]}, {"tStartMs": 29840, "dDurationMs": 2160, "segs": [{"utf8": "下一个人类探索阶段", "tOffsetMs": 0}]}, {"tStartMs": 32000, "dDurationMs": 2960, "segs": [{"utf8": "我们明年启动的任务显示了美国的领导地位", "tOffsetMs": 0}]}, {"tStartMs": 34960, "dDurationMs": 2800, "segs": [{"utf8": "和阿尔特米斯计划 带领人类回到太空", "tOffsetMs": 0}]}, {"tStartMs": 37760, "dDurationMs": 8040, "segs": [{"utf8": "月亮和火星 带领人类和美国在太空。", "tOffsetMs": 0}]}], "wireMagic": "mb1", "lang": "zh-Hans"}