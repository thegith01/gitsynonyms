{"events": [{"tStartMs": 400, "dDurationMs": 1600, "segs": [{"utf8": "那么,发生了什么事?", "tOffsetMs": 0}]}, {"tStartMs": 2000, "dDurationMs": 2800, "segs": [{"utf8": "对吧? 我听过很多像马克·韦恩那样的传闻", "tOffsetMs": 0}]}, {"tStartMs": 4800, "dDurationMs": 3700, "segs": [{"utf8": "嗯,但是,呃,我们有 一个令人难以置信的老 空中交通", "tOffsetMs": 0}]}, {"tStartMs": 8500, "dDurationMs": 3800, "segs": [{"utf8": "控制系统。 我想每个你的网络", "tOffsetMs": 0}]}, {"tStartMs": 12300, "dDurationMs": 3999, "segs": [{"utf8": "总统和我谈这个", "tOffsetMs": 0}]}, {"tStartMs": 16299, "dDurationMs": 3301, "segs": [{"utf8": "过去两年 去年的总统", "tOffsetMs": 0}]}, {"tStartMs": 19600, "dDurationMs": 4500, "segs": [{"utf8": "一直要求国会全额资助 呃,一个完整的建筑", "tOffsetMs": 0}]}, {"tStartMs": 24100, "dDurationMs": 2300, "segs": [{"utf8": "全新的空中交通管制系统", "tOffsetMs": 0}]}, {"tStartMs": 26400, "dDurationMs": 2700, "segs": [{"utf8": "所以,我们有TDM uh电信。", "tOffsetMs": 0}]}, {"tStartMs": 29100, "dDurationMs": 2200, "segs": [{"utf8": "所以,这是模拟电信。", "tOffsetMs": 0}]}, {"tStartMs": 31300, "dDurationMs": 3900, "segs": [{"utf8": "我们的开关,呃... 我们的路由器被超载了", "tOffsetMs": 0}]}, {"tStartMs": 35200, "dDurationMs": 2200, "segs": [{"utf8": "数据和它们都消失了。", "tOffsetMs": 0}]}, {"tStartMs": 37400, "dDurationMs": 1900, "segs": [{"utf8": "我不应该说他们倒下了。", "tOffsetMs": 0}]}, {"tStartMs": 39300, "dDurationMs": 3500, "segs": [{"utf8": "他们开始让我们 数据不一致,呃,从", "tOffsetMs": 0}]}, {"tStartMs": 42800, "dDurationMs": 2200, "segs": [{"utf8": "那些路由器里的东西", "tOffsetMs": 0}]}, {"tStartMs": 45000, "dDurationMs": 2500, "segs": [{"utf8": "因此,我们关闭了系统。", "tOffsetMs": 0}]}, {"tStartMs": 47500, "dDurationMs": 2900, "segs": [{"utf8": "现在,我已经更换了一些开关", "tOffsetMs": 0}]}, {"tStartMs": 50400, "dDurationMs": 4100, "segs": [{"utf8": "川普总统. 我们的新IP开关没有掉下去", "tOffsetMs": 0}]}, {"tStartMs": 54500, "dDurationMs": 2900, "segs": [{"utf8": "是旧的硬件坏了", "tOffsetMs": 0}]}, {"tStartMs": 57400, "dDurationMs": 4100, "segs": [{"utf8": "我认为美国人民的问题是你", "tOffsetMs": 0}]}, {"tStartMs": 61500, "dDurationMs": 1900, "segs": [{"utf8": "要国会资助吗?", "tOffsetMs": 0}]}, {"tStartMs": 63400, "dDurationMs": 2700, "segs": [{"utf8": "川普总统要求钱。", "tOffsetMs": 0}]}, {"tStartMs": 66100, "dDurationMs": 4000, "segs": [{"utf8": "他要求国会采取两党制的方法", "tOffsetMs": 0}]}, {"tStartMs": 70100, "dDurationMs": 3700, "segs": [{"utf8": "说给我们资源 建立一个先进的", "tOffsetMs": 0}]}, {"tStartMs": 73800, "dDurationMs": 4400, "segs": [{"utf8": "空中交通管制系统. 让我们不要做一个补丁 嗯", "tOffsetMs": 0}]}, {"tStartMs": 78200, "dDurationMs": 3600, "segs": [{"utf8": "修复一个对每个家庭都至关重要的系统", "tOffsetMs": 0}]}, {"tStartMs": 81800, "dDurationMs": 2000, "segs": [{"utf8": "非红非蓝非民主.", "tOffsetMs": 0}]}, {"tStartMs": 83800, "dDurationMs": 2400, "segs": [{"utf8": "共和党人. 是美国人", "tOffsetMs": 0}]}, {"tStartMs": 86200, "dDurationMs": 1800, "segs": [{"utf8": "给我们钱修好它。", "tOffsetMs": 0}]}, {"tStartMs": 88000, "dDurationMs": 2900, "segs": [{"utf8": "现在,如果你看看过去的政府, 返回25", "tOffsetMs": 0}]}, {"tStartMs": 90900, "dDurationMs": 6100, "segs": [{"utf8": "已经给了联邦航空局150亿元 用来修复这个", "tOffsetMs": 0}]}, {"tStartMs": 97000, "dDurationMs": 1700, "segs": [{"utf8": "空中交通管制系统.", "tOffsetMs": 0}]}, {"tStartMs": 98700, "dDurationMs": 3200, "segs": [{"utf8": "你猜怎么着? 几乎什么都没做", "tOffsetMs": 0}]}, {"tStartMs": 101900, "dDurationMs": 1500, "segs": [{"utf8": "我们有一个定金。", "tOffsetMs": 0}]}, {"tStartMs": 103400, "dDurationMs": 2800, "segs": [{"utf8": "特朗普总统要求的 在 呃 一个大美丽的", "tOffsetMs": 0}]}, {"tStartMs": 106200, "dDurationMs": 2400, "segs": [{"utf8": "125亿美元", "tOffsetMs": 0}]}, {"tStartMs": 108600, "dDurationMs": 3900, "segs": [{"utf8": "我们正用这125亿美元 建造其中一部分", "tOffsetMs": 0}]}, {"tStartMs": 112500, "dDurationMs": 2300, "segs": [{"utf8": "特朗普总统离开后 建筑工程将会完成", "tOffsetMs": 0}]}, {"tStartMs": 114800, "dDurationMs": 3400, "segs": [{"utf8": "办公室 我们以从未有过的速度前进", "tOffsetMs": 0}]}, {"tStartMs": 118200, "dDurationMs": 2892, "segs": [{"utf8": "之前关于联邦航空局的情况", "tOffsetMs": 0}]}, {"tStartMs": 121092, "dDurationMs": 2800, "segs": [{"utf8": "但这是部分资金", "tOffsetMs": 0}]}, {"tStartMs": 123892, "dDurationMs": 3100, "segs": [{"utf8": "我认为美国要求国会给予", "tOffsetMs": 0}]}, {"tStartMs": 126992, "dDurationMs": 2400, "segs": [{"utf8": "完成法案的资源。", "tOffsetMs": 0}]}, {"tStartMs": 129392, "dDurationMs": 5300, "segs": [{"utf8": "嗯,我认为国会 在一个点看", "tOffsetMs": 0}]}, {"tStartMs": 134692, "dDurationMs": 3100, "segs": [{"utf8": "FAA的历史,并说我们不信任你。", "tOffsetMs": 0}]}, {"tStartMs": 137792, "dDurationMs": 3000, "segs": [{"utf8": "嗯,与特朗普总统 我们所做的,我认为", "tOffsetMs": 0}]}, {"tStartMs": 140792, "dDurationMs": 3500, "segs": [{"utf8": "他们信任我们,因为我们先做的", "tOffsetMs": 0}]}, {"tStartMs": 144292, "dDurationMs": 1600, "segs": [{"utf8": "一笔钱", "tOffsetMs": 0}]}, {"tStartMs": 145892, "dDurationMs": 3000, "segs": [{"utf8": "所以有了全新的最先进的系统 你", "tOffsetMs": 0}]}, {"tStartMs": 148892, "dDurationMs": 1600, "segs": [{"utf8": "不会有这些停电。", "tOffsetMs": 0}]}, {"tStartMs": 150492, "dDurationMs": 2100, "segs": [{"utf8": "所以,你今天的经历, 但你可以回想,很多", "tOffsetMs": 0}]}, {"tStartMs": 152592, "dDurationMs": 3333, "segs": [{"utf8": "从一年半前开始,我们...", "tOffsetMs": 0}]}, {"tStartMs": 155925, "dDurationMs": 2167, "segs": [{"utf8": "纽瓦克断电 纽瓦克断电", "tOffsetMs": 0}]}, {"tStartMs": 158092, "dDurationMs": 4100, "segs": [{"utf8": "这是一个持续的问题,我们有嗯,它应该", "tOffsetMs": 0}]}, {"tStartMs": 162192, "dDurationMs": 5400, "segs": [{"utf8": "修复。 嗯,所以我们想做什么,嗯,我问", "tOffsetMs": 0}]}, {"tStartMs": 167592, "dDurationMs": 2300, "segs": [{"utf8": "总统要求300亿美元。", "tOffsetMs": 0}]}, {"tStartMs": 169892, "dDurationMs": 1500, "segs": [{"utf8": "我要500亿", "tOffsetMs": 0}]}, {"tStartMs": 171392, "dDurationMs": 1500, "segs": [{"utf8": "顺便说一句,如果你看看国会多少钱", "tOffsetMs": 0}]}, {"tStartMs": 172892, "dDurationMs": 3800, "segs": [{"utf8": "花费, 彼得,你覆盖国会, 他们浪费了很多", "tOffsetMs": 0}]}, {"tStartMs": 176692, "dDurationMs": 2600, "segs": [{"utf8": "钱 还有什么比空中交通更重要的?", "tOffsetMs": 0}]}, {"tStartMs": 179292, "dDurationMs": 2300, "segs": [{"utf8": "实际有效的控制系统?", "tOffsetMs": 0}]}, {"tStartMs": 181592, "dDurationMs": 1900, "segs": [{"utf8": "于是总统说,你知道吗?", "tOffsetMs": 0}]}, {"tStartMs": 183492, "dDurationMs": 2000, "segs": [{"utf8": "让我们完成这项工作。", "tOffsetMs": 0}]}, {"tStartMs": 185492, "dDurationMs": 4600, "segs": [{"utf8": "新硬件,新软件,新电信.", "tOffsetMs": 0}]}, {"tStartMs": 190092, "dDurationMs": 3400, "segs": [{"utf8": "我们的很多塔都将近100年了", "tOffsetMs": 0}]}, {"tStartMs": 193492, "dDurationMs": 2700, "segs": [{"utf8": "我们的空中交通管制员有漏气的屋顶和空气", "tOffsetMs": 0}]}, {"tStartMs": 196192, "dDurationMs": 1500, "segs": [{"utf8": "条件不起作用。", "tOffsetMs": 0}]}, {"tStartMs": 197692, "dDurationMs": 2100, "segs": [{"utf8": "气势高,电梯不通.", "tOffsetMs": 0}]}, {"tStartMs": 199792, "dDurationMs": 3100, "segs": [{"utf8": "他们的屋顶漏水了 嗯,我想要新的塔楼。", "tOffsetMs": 0}]}, {"tStartMs": 202892, "dDurationMs": 3100, "segs": [{"utf8": "我们也应该投资 在很多机场周围", "tOffsetMs": 0}]}, {"tStartMs": 205992, "dDurationMs": 3500, "segs": [{"utf8": "老实说,他们中很多人都很尴尬", "tOffsetMs": 0}]}, {"tStartMs": 209492, "dDurationMs": 3800, "segs": [{"utf8": "收钱吧 我们投资吧 这样我们就不用来了", "tOffsetMs": 0}]}, {"tStartMs": 213292, "dDurationMs": 4500, "segs": [{"utf8": "晚上8: 30,并举行记者招待会 关于为什么播出", "tOffsetMs": 0}]}, {"tStartMs": 217792, "dDurationMs": 3200, "segs": [{"utf8": "旅行被关闭, 为什么我们有数万", "tOffsetMs": 0}]}, {"tStartMs": 220992, "dDurationMs": 3400, "segs": [{"utf8": "机场里的人 和家人分居了", "tOffsetMs": 0}]}, {"tStartMs": 224392, "dDurationMs": 2900, "segs": [{"utf8": "没有,嗯,没有,嗯... ...不知道他们在哪里", "tOffsetMs": 0}]}, {"tStartMs": 227292, "dDurationMs": 1500, "segs": [{"utf8": "今晚要睡觉了", "tOffsetMs": 0}]}, {"tStartMs": 228792, "dDurationMs": 2900, "segs": [{"utf8": "现在,你可能 捡起来,呃,我们如何我们已经", "tOffsetMs": 0}]}, {"tStartMs": 231692, "dDurationMs": 1500, "segs": [{"utf8": "发现了问题。", "tOffsetMs": 0}]}, {"tStartMs": 233192, "dDurationMs": 2400, "segs": [{"utf8": "我们有我们的中心 和我们的TRACONs运行的权利", "tOffsetMs": 0}]}, {"tStartMs": 235592, "dDurationMs": 4700, "segs": [{"utf8": "现在 所以今晚8点15分 东部时间 我们已经开了", "tOffsetMs": 0}]}, {"tStartMs": 240292, "dDurationMs": 2902, "segs": [{"utf8": "在空气空间。 这是否意味着每一次飞行都要进行", "tOffsetMs": 0}]}, {"tStartMs": 243194, "dDurationMs": 1800, "segs": [{"utf8": "现在飞?", "tOffsetMs": 0}]}, {"tStartMs": 244994, "dDurationMs": 1700, "segs": [{"utf8": "它会是缓慢的,对不对?", "tOffsetMs": 0}]}, {"tStartMs": 246694, "dDurationMs": 3300, "segs": [{"utf8": "所以,如果你在看, 你在机场,嗯检查", "tOffsetMs": 0}]}, {"tStartMs": 249994, "dDurationMs": 2700, "segs": [{"utf8": "还有你的航空公司 要看我们有没有船员", "tOffsetMs": 0}]}, {"tStartMs": 252694, "dDurationMs": 3100, "segs": [{"utf8": "可以吗? 我们有没有飞行员和空姐", "tOffsetMs": 0}]}, {"tStartMs": 255794, "dDurationMs": 2000, "segs": [{"utf8": "可以飞你的飞机吗? 我们要试着像", "tOffsetMs": 0}]}, {"tStartMs": 257794, "dDurationMs": 3500, "segs": [{"utf8": "我们今晚能做的很多 如果我们有能力的话", "tOffsetMs": 0}]}, {"tStartMs": 261294, "dDurationMs": 2400, "segs": [{"utf8": "与机组人员移动这些航班。", "tOffsetMs": 0}]}, {"tStartMs": 263694, "dDurationMs": 2600, "segs": [{"utf8": "如果不行,我们明天早上开始", "tOffsetMs": 0}]}, {"tStartMs": 266294, "dDurationMs": 5000, "segs": [{"utf8": "航空公司合伙人,嗯移动那些飞机。", "tOffsetMs": 0}]}], "wireMagic": "mb1", "lang": "zh-Hans"}