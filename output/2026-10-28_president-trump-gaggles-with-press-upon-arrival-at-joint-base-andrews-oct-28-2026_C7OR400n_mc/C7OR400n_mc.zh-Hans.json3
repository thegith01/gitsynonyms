onMs": 1440, "segs": [{"utf8": "如果你最终会失去你的国家", "tOffsetMs": 0}]}, {"tStartMs": 261120, "dDurationMs": 2320, "segs": [{"utf8": "你不做某事。但这是一个", "tOffsetMs": 0}]}, {"tStartMs": 263440, "dDurationMs": 2880, "segs": [{"utf8": "移民。你有讨厌的人", "tOffsetMs": 0}]}, {"tStartMs": 266320, "dDurationMs": 2319, "segs": [{"utf8": "法国。他们讨厌建筑物，讨厌", "tOffsetMs": 0}]}, {"tStartMs": 268639, "dDurationMs": 3441, "segs": [{"utf8": "艺术，讨厌他们讨厌的人。", "tOffsetMs": 0}]}, {"tStartMs": 272080, "dDurationMs": 2399, "segs": [{"utf8": "他们就在那里", "tOffsetMs": 0}]}, {"tStartMs": 274479, "dDurationMs": 1361, "segs": [{"utf8": "你得把他们救出来。某事", "tOffsetMs": 0}]}, {"tStartMs": 275840, "dDurationMs": 2480, "segs": [{"utf8": "必须发生，他们最好这样做", "tOffsetMs": 0}]}, {"tStartMs": 278320, "dDurationMs": 2319, "segs": [{"utf8": "某事。我已经说了10遍了", "tOffsetMs": 0}]}, {"tStartMs": 280639, "dDurationMs": 2321, "segs": [{"utf8": "总统任期。我认识他", "tOffsetMs": 0}]}, {"tStartMs": 282960, "dDurationMs": 4000, "segs": [{"utf8": "很长一段时间了", "tOffsetMs": 0}]}, {"tStartMs": 286960, "dDurationMs": 1920, "segs": [{"utf8": "我认为法国发生的事情", "tOffsetMs": 0}]}, {"tStartMs": 288880, "dDurationMs": 5039, "segs": [{"utf8": "欧洲其他国家非常难过。", "tOffsetMs": 0}]}, {"tStartMs": 293919, "dDurationMs": 1921, "segs": [{"utf8": "和史蒂夫·惠特一起在飞机上", "tOffsetMs": 0}]}, {"tStartMs": 295840, "dDurationMs": 1760, "segs": [{"utf8": "今天。你能告诉我们你什么吗", "tOffsetMs": 0}]}, {"tStartMs": 297600, "dDurationMs": 1920, "segs": [{"utf8": "讨论过？与伊朗有关还是", "tOffsetMs": 0}]}, {"tStartMs": 299520, "dDurationMs": 880, "segs": [{"utf8": "俄罗斯？", "tOffsetMs": 0}]}, {"tStartMs": 300400, "dDurationMs": 1840, "segs": [{"utf8": ">> 我们谈论了伊朗，谈论了", "tOffsetMs": 0}]}, {"tStartMs": 302240, "dDurationMs": 2640, "segs": [{"utf8": "俄罗斯，我认为与俄罗斯一起，我们", "tOffsetMs": 0}]}, {"tStartMs": 304880, "dDurationMs": 3120, "segs": [{"utf8": "与俄罗斯取得很大进展", "tOffsetMs": 0}]}, {"tStartMs": 308000, "dDurationMs": 1520, "segs": [{"utf8": "乌克兰。", "tOffsetMs": 0}]}, {"tStartMs": 309520, "dDurationMs": 1679, "segs": [{"utf8": "很快就会召开一次会议。", "tOffsetMs": 0}]}, {"tStartMs": 311199, "dDurationMs": 1761, "segs": [{"utf8": "我认为正在取得很多进展", "tOffsetMs": 0}]}, {"tStartMs": 312960, "dDurationMs": 3760, "segs": [{"utf8": "被迫停止与普京总统的接触", "tOffsetMs": 0}]}, {"tStartMs": 316720, "dDurationMs": 2400, "segs": [{"utf8": "祖林斯基总统。", "tOffsetMs": 0}]}, {"tStartMs": 319120, "dDurationMs": 2079, "segs": [{"utf8": "我认为已经取得了很多进展。我", "tOffsetMs": 0}]}, {"tStartMs": 321199, "dDurationMs": 2481, "segs": [{"utf8": "想想呃，与伊朗，我们的关系非常好", "tOffsetMs": 0}]}, {"tStartMs": 323680, "dDurationMs": 1680, "segs": [{"utf8": "位置。", "tOffsetMs": 0}]}, {"tStartMs": 325360, "dDurationMs": 1839, "segs": [{"utf8": "这是一个问题 我想什么时候结束", "tOffsetMs": 0}]}, {"tStartMs": 327199, "dDurationMs": 2961, "segs": [{"utf8": "它。只是一个问题：我什么时候想要", "tOffsetMs": 0}]}, {"tStartMs": 330160, "dDurationMs": 3520, "segs": [{"utf8": "结束它，呃他们想要我他们想要", "tOffsetMs": 0}]}, {"tStartMs": 333680, "dDurationMs": 1359, "segs": [{"utf8": "达成协议，但他们想要", "tOffsetMs": 0}]}, {"tStartMs": 335039, "dDurationMs": 2160, "segs": [{"utf8": "达成交易，但他们喜欢利用它", "tOffsetMs": 0}]}, {"tStartMs": 337199, "dDurationMs": 2081, "segs": [{"utf8": "沿着。也许他们正在等待", "tOffsetMs": 0}]}, {"tStartMs": 339280, "dDurationMs": 1759, "segs": [{"utf8": "选举什么的，但这不是", "tOffsetMs": 0}]}, {"tStartMs": 341039, "dDurationMs": 2160, "segs": [{"utf8": "去帮助他们。选举不", "tOffsetMs": 0}]}, {"tStartMs": 343199, "dDurationMs": 2801, "segs": [{"utf8": "去帮助他们。但我想我们已经", "tOffsetMs": 0}]}, {"tStartMs": 346000, "dDurationMs": 2160, "segs": [{"utf8": "呃，看，我们已经消灭了他们的军队。", "tOffsetMs": 0}]}, {"tStartMs": 348160, "dDurationMs": 2560, "segs": [{"utf8": "我们已经摧毁了他们的财务。他们", "tOffsetMs": 0}]}, {"tStartMs": 350720, "dDurationMs": 2560, "segs": [{"utf8": "没有钱。他们有通货膨胀，", "tOffsetMs": 0}]}, {"tStartMs": 353280, "dDurationMs": 3359, "segs": [{"utf8": "全球最高，截至 2019 年 301%", "tOffsetMs": 0}]}, {"tStartMs": 356639, "dDurationMs": 2560, "segs": [{"utf8": "几天前，但我们看看会发生什么", "tOffsetMs": 0}]}, {"tStartMs": 359199, "dDurationMs": 1681, "segs": [{"utf8": "发生。我们处于有利位置", "tOffsetMs": 0}]}, {"tStartMs": 360880, "dDurationMs": 1840, "segs": [{"utf8": "不管怎样。", "tOffsetMs": 0}]}, {"tStartMs": 362720, "dDurationMs": 2000, "segs": [{"utf8": ">> 选举后针对伊朗的袭击。", "tOffsetMs": 0}]}, {"tStartMs": 364720, "dDurationMs": 1759, "segs": [{"utf8": ">> 我不能告诉你。我的意思是，我不能", "tOffsetMs": 0}]}, {"tStartMs": 366479, "dDurationMs": 2241, "segs": [{"utf8": "当然可以告诉你，但是", "tOffsetMs": 0}]}, {"tStartMs": 368720, "dDurationMs": 1680, "segs": [{"utf8": ">> 一切皆有可能，但我不知道", "tOffsetMs": 0}]}, {"tStartMs": 370400, "dDurationMs": 3280, "segs": [{"utf8": "你。副总统最近表示", "tOffsetMs": 0}]}, {"tStartMs": 373680, "dDurationMs": 3200, "segs": [{"utf8": "如果他竞选，他希望得到你的支持", "tOffsetMs": 0}]}, {"tStartMs": 376880, "dDurationMs": 3200, "segs": [{"utf8": "总统。呃，你会支持他吗？", "tOffsetMs": 0}]}, {"tStartMs": 380080, "dDurationMs": 1760, "segs": [{"utf8": ">> 好吧，不，他甚至没有跟我说过话", "tOffsetMs": 0}]}, {"tStartMs": 381840, "dDurationMs": 2160, "segs": [{"utf8": "现在考虑这个还为时过早", "tOffsetMs": 0}]}, {"tStartMs": 384000, "dDurationMs": 2240, "segs": [{"utf8": "关于它。但我可以告诉你我喜欢他", "tOffsetMs": 0}]}, {"tStartMs": 386240, "dDurationMs": 2399, "segs": [{"utf8": "很多。他是一个非常有能力的人。他是", "tOffsetMs": 0}]}, {"tStartMs": 388639, "dDurationMs": 1280, "segs": [{"utf8": "做好工作。他在外面", "tOffsetMs": 0}]}, {"tStartMs": 389919, "dDurationMs": 3280, "segs": [{"utf8": "我也很喜欢他", "tOffsetMs": 0}]}, {"tStartMs": 393199, "dDurationMs": 4161, "segs": [{"utf8": "我喜欢很多人。你看到了", "tOffsetMs": 0}]}, {"tStartMs": 397360, "dDurationMs": 2640, "segs": [{"utf8": "马可今晚得到的手。马可·鲁比奥", "tOffsetMs": 0}]}, {"tStartMs": 400000, "dDurationMs": 2720, "segs": [{"utf8": "有一手大手，他们喜欢他。他们", "tOffsetMs": 0}]}, {"tStartMs": 402720, "dDurationMs": 1919, "segs": [{"utf8": "就像我的人民一样。我们有一个很棒的团队", "tOffsetMs": 0}]}, {"tStartMs": 404639, "dDurationMs": 2481, "segs": [{"utf8": "的人。非常有才华。这是一个", "tOffsetMs": 0}]}, {"tStartMs": 407120, "dDurationMs": 2799, "segs": [{"utf8": "巨大的内阁。我想也许是", "tOffsetMs": 0}]}, {"tStartMs": 409919, "dDurationMs": 1521, "segs": [{"utf8": "有史以来最好的。", "tOffsetMs": 0}]}, {"tStartMs": 411440, "dDurationMs": 1680, "segs": [{"utf8": ">> 您什么时候会见普京？", "tOffsetMs": 0}]}, {"tStartMs": 413120, "dDurationMs": 2160, "segs": [{"utf8": "泽林斯基？你什么时候想", "tOffsetMs": 0}]}, {"tStartMs": 415280, "dDurationMs": 3440, "segs": [{"utf8": "很快就会有这件事，你知道，", "tOffsetMs": 0}]}, {"tStartMs": 418720, "dDurationMs": 1360, "segs": [{"utf8": ">> 我想说这将是一次会议。", "tOffsetMs": 0}]}, {"tStartMs": 420080, "dDurationMs": 1360, "segs": [{"utf8": "他们想开个会。那么，我们将", "tOffsetMs": 0}]}, {"tStartMs": 421440, "dDurationMs": 1759, "segs": [{"utf8": "瞧。我们可能会做到这一点", "tOffsetMs": 0}]}, {"tStartMs": 423199, "dDurationMs": 2081, "segs": [{"utf8": "不一定是通过会议完成的", "tOffsetMs": 0}]}, {"tStartMs": 425280, "dDurationMs": 2319, "segs": [{"utf8": "否则也是，但我会说它会", "tOffsetMs": 0}]}, {"tStartMs": 427599, "dDurationMs": 1761, "segs": [{"utf8": "发生在接下来不久", "tOffsetMs": 0}]}, {"tStartMs": 429360, "dDurationMs": 2959, "segs": [{"utf8": "期间。", "tOffsetMs": 0}]}, {"tStartMs": 432319, "dDurationMs": 1921, "segs": [{"utf8": ">> 这不包括 Zilinski 当你", "tOffsetMs": 0}]}, {"tStartMs": 434240, "dDurationMs": 1519, "segs": [{"utf8": "去亚洲。", "tOffsetMs": 0}]}, {"tStartMs": 435759, "dDurationMs": 2160, "segs": [{"utf8": ">> 好吧，如果不包括的话我会的", "tOffsetMs": 0}]}, {"tStartMs": 437919, "dDurationMs": 2081, "segs": [{"utf8": "乌克兰。要知道，俄罗斯是一个大国", "tOffsetMs": 0}]}, {"tStartMs": 440000, "dDurationMs": 3039, "segs": [{"utf8": "国家。呃我们正在和呃见面", "tOffsetMs": 0}]}, {"tStartMs": 443039, "dDurationMs": 2801, "segs": [{"utf8": "已与习主席安排", "tOffsetMs": 0}]}, {"tStartMs": 445840, "dDurationMs": 4240, "segs": [{"utf8": "中国和我们就核问题举行会议", "tOffsetMs": 0}]}, {"tStartMs": 450080, "dDurationMs": 1839, "segs": [{"utf8": "裁军是一项非常伟大的事业", "tOffsetMs": 0}]}, {"tStartMs": 451919, "dDurationMs": 2081, "segs": [{"utf8": "就我而言也许会见面", "tOffsetMs": 0}]}, {"tStartMs": 454000, "dDurationMs": 2720, "segs": [{"utf8": "这是最重要的一次会议，所以我们", "tOffsetMs": 0}]}, {"tStartMs": 456720, "dDurationMs": 2000, "segs": [{"utf8": "我们有没有讨论过", "tOffsetMs": 0}]}, {"tStartMs": 458720, "dDurationMs": 3599, "segs": [{"utf8": "呃各种无核化", "tOffsetMs": 0}]}, {"tStartMs": 462319, "dDurationMs": 2320, "segs": [{"utf8": "国家，所以俄罗斯肯定适合", "tOffsetMs": 0}]}, {"tStartMs": 464639, "dDurationMs": 2801, "segs": [{"utf8": "我们拥有最多的核武器", "tOffsetMs": 0}]}, {"tStartMs": 467440, "dDurationMs": 2800, "segs": [{"utf8": "俄罗斯第二名 非常接近 非常接近", "tOffsetMs": 0}]}, {"tStartMs": 470240, "dDurationMs": 2480, "segs": [{"utf8": "落后，中国还远", "tOffsetMs": 0}]}, {"tStartMs": 472720, "dDurationMs": 2800, "segs": [{"utf8": "落后了，但他们会在 5 天内追上我们", "tOffsetMs": 0}]}, {"tStartMs": 475520, "dDurationMs": 3679, "segs": [{"utf8": "这么多年了，这一切都没有意义。所以，", "tOffsetMs": 0}]}, {"tStartMs": 479199, "dDurationMs": 1761, "segs": [{"utf8": "我们谈论这个。我们实际上说话", "tOffsetMs": 0}]}, {"tStartMs": 480960, "dDurationMs": 1359, "segs": [{"utf8": "关于它很多。", "tOffsetMs": 0}]}, {"tStartMs": 482319, "dDurationMs": 1921, "segs": [{"utf8": ">> 我猜他们没有开会", "tOffsetMs": 0}]}, {"tStartMs": 484240, "dDurationMs": 2639, "segs": [{"utf8": "与习主席的核裁军", "tOffsetMs": 0}]}, {"tStartMs": 486879, "dDurationMs": 2720, "segs": [{"utf8": "和普京总统。我们会有一个", "tOffsetMs": 0}]}, {"tStartMs": 489599, "dDurationMs": 4801, "segs": [{"utf8": "除了无核化之外的话题", "tOffsetMs": 0}]}, {"tStartMs": 494400, "dDurationMs": 4799, "segs": [{"utf8": "我的意思是当你看到17800时", "tOffsetMs": 0}]}, {"tStartMs": 499199, "dDurationMs": 3680, "segs": [{"utf8": "这些令人难以置信的致命", "tOffsetMs": 0}]}, {"tStartMs": 502879, "dDurationMs": 4561, "segs": [{"utf8": "导弹，呃，非常危险的东西", "tOffsetMs": 0}]}, {"tStartMs": 507440, "dDurationMs": 2879, "segs": [{"utf8": "非常非常危险的东西", "tOffsetMs": 0}]}, {"tStartMs": 510319, "dDurationMs": 2881, "segs": [{"utf8": "在这方面可以做的是", "tOffsetMs": 0}]}, {"tStartMs": 513200, "dDurationMs": 2240, "segs": [{"utf8": "太好了，这不是一件容易的事", "tOffsetMs": 0}]}, {"tStartMs": 515440, "dDurationMs": 1920, "segs": [{"utf8": "因为没有人愿意只是说", "tOffsetMs": 0}]}, {"tStartMs": 517360, "dDurationMs": 2000, "segs": [{"utf8": "好吧，因为你还有其他", "tOffsetMs": 0}]}, {"tStartMs": 519360, "dDurationMs": 2880, "segs": [{"utf8": "数量少得多的国家，", "tOffsetMs": 0}]}, {"tStartMs": 522240, "dDurationMs": 2320, "segs": [{"utf8": "但他们也拥有核武器。所以，", "tOffsetMs": 0}]}, {"tStartMs": 524560, "dDurationMs": 1920, "segs": [{"utf8": "这会变得很困难。非常感谢", "tOffsetMs": 0}]}, {"tStartMs": 526480, "dDurationMs": 3000, "segs": [{"utf8": "很多。", "tOffsetMs": 0}]}], "wireMagic": "mb1", "lang": "zh-Hans"}