  "rubric": {
    "version": "1.0",
    "dimensions": [
      {
        "id": "similarity",
        "label": "音色相似度",
        "weight": 30,
        "rule": "盲听相似度（1–5）或说话人相似度 SS；不同量纲只做同表内相对比较"
      },
      {
        "id": "languages",
        "label": "中英与跨语种",
        "weight": 20,
        "rule": "中文、英语都能克隆且支持跨语种为满分；单语或需重训减半"
      },
      {
        "id": "naturalness",
        "label": "自然度与韵律",
        "weight": 15,
        "rule": "长句韵律、停顿、情感可控性；盲听自然度优先"
      },
      {
        "id": "cost",
        "label": "成本",
        "weight": 10,
        "rule": "按每千字符或每分钟合成计价；自托管只计算力"
      },
      {
        "id": "latency",
        "label": "延迟",
        "weight": 5,
        "rule": "首包时间与批量合成速度"
      },
      {
        "id": "consent",
        "label": "授权与合规",
        "weight": 10,
        "rule": "强制同意校验、水印、可删除、可本地部署；无同意机制的扣分"
      },
      {
        "id": "reproducibility",
        "label": "可复核性",
        "weight": 10,
        "rule": "权重可下载、版本可固定、可离线复跑为满分；纯黑盒 API 减分"
      }
    ]
  },
