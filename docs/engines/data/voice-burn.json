{
  "schema": "module2-engine-registry/1",
  "office": "voice-burn",
  "title": "语音刻录处：TTS 配音与音轨刻录引擎研究与排名",
  "updated_at": "2026-10-27",
  "threshold": 60,
  "rubric": {
    "version": "1.0",
    "dimensions": [
      {
        "id": "zh_naturalness",
        "label": "中文自然度",
        "weight": 25,
        "rule": "普通话韵律、多音字、数字与专名读法；以盲听与母语审听为准"
      },
      {
        "id": "timing_fit",
        "label": "时间轴贴合",
        "weight": 20,
        "rule": "能否按 cue 起止压缩/拉伸、提供词边界或 SSML 语速控制；只能整段合成减半"
      },
      {
        "id": "voice_control",
        "label": "音色与一致性",
        "weight": 15,
        "rule": "音色库规模、跨段落一致性、情感与语速标签"
      },
      {
        "id": "cost",
        "label": "成本",
        "weight": 15,
        "rule": "按每百万字符公开价；自托管只计算力"
      },
      {
        "id": "latency",
        "label": "延迟与吞吐",
        "weight": 10,
        "rule": "3 小时视频、数千条 cue 的批量合成耗时"
      },
      {
        "id": "reproducibility",
        "label": "可复核性",
        "weight": 10,
        "rule": "接口稳定、版本可固定、可离线复跑；非官方接口扣分"
      },
      {
        "id": "compliance",
        "label": "授权合规",
        "weight": 5,
        "rule": "服务条款允许批量合成与商用；catalogue voice 不涉及真人克隆"
      }
    ]
  },
