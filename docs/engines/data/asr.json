{
  "schema": "module2-engine-registry/1",
  "office": "asr",
  "title": "ASR处：语音转写引擎研究与排名",
  "updated_at": "2026-10-27",
  "threshold": 60,
  "rubric": {
    "version": "1.0",
    "dimensions": [
      {
        "id": "accuracy",
        "label": "转写准确率",
        "weight": 30,
        "rule": "以公开独立基准的 WER/CER 为准；干净语音与难音频分别看，不采信单一营销数字"
      },
      {
        "id": "languages",
        "label": "中英语言覆盖",
        "weight": 15,
        "rule": "同时支持英语与简体中文为满分；仅英语或需二次翻译按比例扣分"
      },
      {
        "id": "word_timing",
        "label": "逐词时间戳",
        "weight": 15,
        "rule": "原生逐词起止时间为满分；句级时间戳减半；无时间戳不得分"
      },
      {
        "id": "cost",
        "label": "成本",
        "weight": 15,
        "rule": "按每音频小时公开价折算；自托管只计算力，不计许可证费"
      },
      {
        "id": "latency",
        "label": "延迟与吞吐",
        "weight": 10,
        "rule": "批量转写 3 小时素材的端到端等待时间与并发能力"
      },
      {
        "id": "availability",
        "label": "可获得性",
        "weight": 10,
        "rule": "仓库已有密钥/可直接调用为满分；需新开户或审批按缺口扣分"
      },
      {
        "id": "reproducibility",
        "label": "可复核性",
        "weight": 5,
        "rule": "有版本化模型、公开文档与可重跑命令；仅云端黑盒且条款禁止基准测试的扣分"
      }
    ]
  },
