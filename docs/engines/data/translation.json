  "rubric": {
    "version": "1.0",
    "dimensions": [
      {
        "id": "quality",
        "label": "译文质量",
        "weight": 35,
        "rule": "FLORES/WMT 的 COMET、spBLEU 与 Intento 错误计数优先；厂商自评按八成折算"
      },
      {
        "id": "zh_direction",
        "label": "英译中方向强度",
        "weight": 15,
        "rule": "中文为母语级目标语言、无需中转英语为满分；中文只是长尾语言减半"
      },
      {
        "id": "subtitle_fit",
        "label": "字幕适配",
        "weight": 15,
        "rule": "能保持逐条对应、控制行长、按批返回 JSON 为满分；整段自由改写扣分"
      },
      {
        "id": "cost",
        "label": "成本",
        "weight": 15,
        "rule": "按每百万源字符公开价折算；本地模型只计算力"
      },
      {
        "id": "latency",
        "label": "延迟与吞吐",
        "weight": 10,
        "rule": "3000+ 条 cue 的批量翻译耗时与限流风险"
      },
      {
        "id": "availability",
        "label": "可获得性",
        "weight": 5,
        "rule": "仓库已有密钥为满分；需新开户或商务流程按缺口扣分"
      },
      {
        "id": "reproducibility",
        "label": "可复核性",
        "weight": 5,
        "rule": "模型版本可固定、输出可重跑；云端模型随时换版扣分"
      }
    ]
  },
